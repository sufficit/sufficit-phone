{
  "schemaVersion": 1,
  "manifestId": "sufficit-phone-desktop.v1",
  "rolloutMode": "Enforce",
  "scopes": [
    {
      "name": "provisioning.installation",
      "displayName": "Provisionamento de instalacoes do Sufficit Phone",
